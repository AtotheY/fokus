{
  "productName": "Fokus",
  "version": "0.4.5",
  "identifier": "dev.usefokus.app",
  "build": { "frontendDist": "../web" },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fokus",
        "width": 1020,
        "height": 730,
        "minWidth": 430,
        "minHeight": 490,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
